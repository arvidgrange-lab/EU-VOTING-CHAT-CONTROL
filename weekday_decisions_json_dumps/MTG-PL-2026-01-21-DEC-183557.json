            "decisionAboutId": "1-243",
            "decisionAboutId_XMLLiteral": "<am><reference_range><reference><number>1</number></reference><reference><number>243</number></reference></reference_range></am>",
            "referenceText": {
                "pl": "Poprawki komisji przedmiotowo w\u0142a\u015bciwej \u2013 g\u0142osowanie \u0142\u0105czne",
                "pt": "Altera\u00e7\u00f5es da comiss\u00e3o competente \u2013 vota\u00e7\u00e3o em bloco",
                "da": "\u00c6ndringsforslag fra det korresponderende udvalg \u2013 afstemning under \u00e9t",
                "hr": "Amandmani nadle\u017enog odbora \u2013 skupno glasovanje",
                "de": "\u00c4nderungsantr\u00e4ge des federf\u00fchrenden Ausschusses\u00a0\u2013 Abstimmung en bloc",
                "ro": "Amendamente ale comisiei competente - vot \u00een bloc",
                "mt": "Emendi tal-kumitat responsabbli - votazzjoni kollettiva",
                "el": "\u03a4\u03c1\u03bf\u03c0\u03bf\u03bb\u03bf\u03b3\u03af\u03b5\u03c2 \u03c4\u03b7\u03c2 \u03b1\u03c1\u03bc\u03cc\u03b4\u03b9\u03b1\u03c2 \u03b5\u03c0\u03b9\u03c4\u03c1\u03bf\u03c0\u03ae\u03c2 \u2013 \u03c8\u03b7\u03c6\u03bf\u03c6\u03bf\u03c1\u03af\u03b1 \u03b5\u03bd \u03c3\u03c5\u03bd\u03cc\u03bb\u03c9",
                "bg": "\u0418\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f, \u0432\u043d\u0435\u0441\u0435\u043d\u0438 \u043e\u0442 \u0432\u043e\u0434\u0435\u0449\u0430\u0442\u0430 \u043a\u043e\u043c\u0438\u0441\u0438\u044f \u2013 \u0433\u043b\u0430\u0441\u0443\u0432\u0430\u043d\u0435 \u201e\u0430\u043d \u0431\u043b\u043e\u043a\u201c",
                "cs": "pozm\u011b\u0148ovac\u00ed n\u00e1vrhy p\u0159\u00edslu\u0161n\u00e9ho v\u00fdboru \u2013 hlasov\u00e1n\u00ed najednou",
                "sv": "\u00c4ndringsf\u00f6rslag fr\u00e5n ansvarigt utskott \u2013 samlad omr\u00f6stning",
                "sk": "PN gestorsk\u00e9ho v\u00fdboru \u2013 hlasovanie v\u00a0blokoch",
                "es": "Enmiendas de la comisi\u00f3n competente - votaci\u00f3n conjunta",
                "fi": "asiasta vastaavan valiokunnan tarkistukset \u2013 yhten\u00e4 ryhm\u00e4n\u00e4",
