            "comment": {
                "es": "<remarkFreeTexts order=\"3\">\n                            <title>Varios</title>\n                            <remarkFreeText>\n                                <translation>Las enmiendas 170 y 240 han sido anuladas.</translation>\n                            </remarkFreeText>\n                        </remarkFreeTexts>",
                "cs": "<remarkFreeTexts order=\"3\">\n                            <title>R\u016fzn\u00e9</title>\n                            <remarkFreeText>\n                                <translation>Pn. 170 a 240 byly zru\u0161eny.</translation>\n                            </remarkFreeText>\n                        </remarkFreeTexts>",
                "mt": "<remarkFreeTexts order=\"3\">\n                            <title>Varji</title>\n                            <remarkFreeText>\n                                <translation>L-emendi 170 u 240 t\u0127assru.</translation>\n                            </remarkFreeText>\n                        </remarkFreeTexts>",
                "lv": "<remarkFreeTexts order=\"3\">\n                            <title>Da\u017e\u0101di</title>\n                            <remarkFreeText>\n                                <translation>Groz\u012bjumi Nr.\u00a0170 un 240 bija atcelti.</translation>\n                            </remarkFreeText>\n                        </remarkFreeTexts>",
                "sk": "<remarkFreeTexts order=\"3\">\n                            <title>In\u00e9</title>\n                            <remarkFreeText>\n                                <translation>PN 170 a 240 boli zru\u0161en\u00e9.</translation>\n                            </remarkFreeText>\n                        </remarkFreeTexts>",
                "bg": "<remarkFreeTexts order=\"3\">\n                            <title>\u0420\u0430\u0437\u043d\u0438</title>\n                            <remarkFreeText>\n                                <translation>\u0418\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f 170 \u0438 240 \u0431\u044f\u0445\u0430 \u0430\u043d\u0443\u043b\u0438\u0440\u0430\u043d\u0438.</translation>\n                            </remarkFreeText>\n                        </remarkFreeTexts>",
                "it": "<remarkFreeTexts order=\"3\">\n                            <title>Varie</title>\n                            <remarkFreeText>\n                                <translation>Gli emendamenti 170 e 240 sono stati annullati.</translation>\n                            </remarkFreeText>\n                        </remarkFreeTexts>",
                "sv": "<remarkFreeTexts order=\"3\">\n                            <title>\u00d6vriga fr\u00e5gor</title>\n                            <remarkFreeText>\n                                <translation>\u00c4ndringsf\u00f6rslagen 170 och 240 hade strukits.</translation>\n                            </remarkFreeText>\n                        </remarkFreeTexts>",
                "da": "<remarkFreeTexts order=\"3\">\n                            <title>Diverse</title>\n                            <remarkFreeText>\n                                <translation>\u00c6ndringsforslag 170 og 240 var blevet annulleret.</translation>\n                            </remarkFreeText>\n                        </remarkFreeTexts>",
                "nl": "<remarkFreeTexts order=\"3\">\n                            <title>Diversen</title>\n                            <remarkFreeText>\n                                <translation>Amendementen\u00a0170 en\u00a0240 zijn geannuleerd.</translation>\n                            </remarkFreeText>\n                        </remarkFreeTexts>",
                "pl": "<remarkFreeTexts order=\"3\">\n                            <title>R\u00f3\u017cne</title>\n                            <remarkFreeText>\n                                <translation>Poprawki 170 i 240 zosta\u0142y anulowane.</translation>\n                            </remarkFreeText>\n                        </remarkFreeTexts>",
                "pt": "<remarkFreeTexts order=\"3\"><title>Diversos</title><remarkFreeText><translation>As altera\u00e7\u00f5es 170 e 240 foram retiradas.</translation></remarkFreeText></remarkFreeTexts>",
                "ro": "<remarkFreeTexts order=\"3\">\n                            <title>Diverse</title>\n                            <remarkFreeText>\n                                <translation>Amendamentele 170 \u0219i 240 au fost anulate.</translation>\n                            </remarkFreeText>\n                        </remarkFreeTexts>",
                "el": "<remarkFreeTexts order=\"3\">\n                            <title>\u0394\u03b9\u03ac\u03c6\u03bf\u03c1\u03b1</title>\n                            <remarkFreeText>\n                                <translation>\u039f\u03b9 \u03c4\u03c1\u03bf\u03c0\u03bf\u03bb\u03bf\u03b3\u03af\u03b5\u03c2 170 \u03ba\u03b1\u03b9 240 \u03b1\u03ba\u03c5\u03c1\u03ce\u03b8\u03b7\u03ba\u03b1\u03bd.</translation>\n                            </remarkFreeText>\n                        </remarkFreeTexts>",
                "ga": "<remarkFreeTexts order=\"3\">\n                            <title>Aon ghn\u00f3 eile</title>\n                            <remarkFreeText>\n                                <translation>Cuireadh leasuithe 170 agus 240 ar ceal.</translation>\n                            </remarkFreeText>\n                        </remarkFreeTexts>",
                "lt": "<remarkFreeTexts order=\"3\">\n                            <title>\u012evair\u016bs</title>\n                            <remarkFreeText>\n                                <translation>170 ir 240\u00a0pakeitimai buvo at\u0161aukti.</translation>\n                            </remarkFreeText>\n                        </remarkFreeTexts>",
                "fi": "<remarkFreeTexts order=\"3\">\n                            <title>Muuta</title>\n                            <remarkFreeText>\n                                <translation>Tarkistukset 170 ja 240 mit\u00e4t\u00f6itiin.</translation>\n                            </remarkFreeText>\n                        </remarkFreeTexts>",
                "sl": "<remarkFreeTexts order=\"3\">\n                            <title>Razno</title>\n                            <remarkFreeText>\n                                <translation>Predloga sprememb 170 in 240 sta bila razveljavljena.</translation>\n                            </remarkFreeText>\n                        </remarkFreeTexts>",
                "hu": "<remarkFreeTexts order=\"3\">\n                            <title>Egy\u00e9b</title>\n                            <remarkFreeText>\n                                <translation>A 170. \u00e9s 240. m\u00f3dos\u00edt\u00e1st visszavont\u00e1k.</translation>\n                            </remarkFreeText>\n                        </remarkFreeTexts>",
                "et": "<remarkFreeTexts order=\"3\">\n                            <title>Mitmesugust</title>\n                            <remarkFreeText>\n                                <translation>Muudatusettepanekud 170 ja 240 t\u00fchistati.</translation>\n                            </remarkFreeText>\n                        </remarkFreeTexts>",
                "hr": "<remarkFreeTexts order=\"3\">\n                            <title>Razno</title>\n                            <remarkFreeText>\n                                <translation>Amandmani 170 i 240 povu\u010deni su.</translation>\n                            </remarkFreeText>\n                        </remarkFreeTexts>",
                "de": "<remarkFreeTexts order=\"3\"><title>Verschiedenes</title><remarkFreeText><translation>Die \u00c4nderungsantr\u00e4ge\u00a0170 und 240 wurden annulliert.</translation></remarkFreeText></remarkFreeTexts>",
                "fr": "<remarkFreeTexts order=\"3\"><title>Divers</title><remarkFreeText><translation>Les amendements 170 et 240 ont \u00e9t\u00e9 annul\u00e9s.</translation></remarkFreeText></remarkFreeTexts>",
                "en": "<remarkFreeTexts order=\"3\">\n                            <title>Miscellaneous</title>\n                            <remarkFreeText>\n                                <translation>Amendments 170 and 240 had been cancelled.</translation>\n                            </remarkFreeText>\n                        </remarkFreeTexts>"
            },
