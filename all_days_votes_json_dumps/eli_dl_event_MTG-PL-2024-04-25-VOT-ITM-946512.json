            "comment": {
                "hu": "<remarkFreeTexts order=\"3\"><title>Egy\u00e9b</title><remarkFreeText><translation>A 40. \u00e9s 99. m\u00f3dos\u00edt\u00e1st visszavont\u00e1k.</translation></remarkFreeText></remarkFreeTexts>",
                "mt": "<remarkFreeTexts order=\"3\"><title>Varji</title><remarkFreeText><translation>L-emendi 40 u 99 t\u0127assru.</translation></remarkFreeText></remarkFreeTexts>",
                "en": "<remarkFreeTexts order=\"3\"><title>Miscellaneous</title><remarkFreeText><translation>Amendments 40 and 99 had been cancelled.</translation></remarkFreeText></remarkFreeTexts>",
                "pt": "<remarkFreeTexts order=\"3\"><title>Diversos</title><remarkFreeText><translation>As altera\u00e7\u00f5es 40 e 99 foram anuladas.</translation></remarkFreeText></remarkFreeTexts>",
                "bg": "<remarkFreeTexts order=\"3\"><title>\u0420\u0430\u0437\u043d\u0438</title><remarkFreeText><translation>\u0418\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f 40 \u0438 99 \u0431\u044f\u0445\u0430 \u0430\u043d\u0443\u043b\u0438\u0440\u0430\u043d\u0438.</translation></remarkFreeText></remarkFreeTexts>",
                "sl": "<remarkFreeTexts order=\"3\">\n                            <title>Razno</title>\n                            <remarkFreeText>\n                                <translation>Predloga sprememb 40 in 99 sta bila razveljavljena.</translation>\n                            </remarkFreeText>\n                        </remarkFreeTexts>",
                "lv": "<remarkFreeTexts order=\"3\"><title>Da\u017e\u0101di</title><remarkFreeText><translation>Groz\u012bjumi Nr.\u00a040 un 99 bija atcelti.</translation></remarkFreeText></remarkFreeTexts>",
                "da": "<remarkFreeTexts order=\"3\"><title>Diverse</title><remarkFreeText><translation>\u00c6ndringsforslag 40 og 99 blev taget tilbage.</translation></remarkFreeText></remarkFreeTexts>",
                "de": "<remarkFreeTexts order=\"3\"><title>Verschiedenes</title><remarkFreeText><translation>Die \u00c4nderungsantr\u00e4ge 40 und 99 wurden annulliert.</translation></remarkFreeText></remarkFreeTexts>",
                "ga": "<remarkFreeTexts order=\"3\"><title>Aon ghn\u00f3 eile</title><remarkFreeText><translation>Cuireadh leasuithe 40 agus 99 ar ceal.</translation></remarkFreeText></remarkFreeTexts>",
                "et": "<remarkFreeTexts order=\"3\"><title>Mitmesugust</title><remarkFreeText><translation>Muudatusettepanekud 40 ja 99 t\u00fchistati.</translation></remarkFreeText></remarkFreeTexts>",
                "sv": "<remarkFreeTexts order=\"3\"><title>\u00d6vrigt</title><remarkFreeText><translation>\u00c4ndringsf\u00f6rslagen 40 och 99 hade strukits.</translation></remarkFreeText></remarkFreeTexts>",
                "es": "<remarkFreeTexts order=\"3\"><title>Varios</title><remarkFreeText><translation>Las enmiendas 40 y 99 han sido anuladas.</translation></remarkFreeText></remarkFreeTexts>",
                "pl": "<remarkFreeTexts order=\"3\"><title>R\u00f3\u017cne</title><remarkFreeText><translation>Poprawki 40 i 99 zosta\u0142y anulowane.</translation></remarkFreeText></remarkFreeTexts>",
                "nl": "<remarkFreeTexts order=\"3\"><title>Diversen</title><remarkFreeText><translation>De amendementen\u00a040 en\u00a099 zijn geannuleerd.</translation></remarkFreeText></remarkFreeTexts>",
                "lt": "<remarkFreeTexts order=\"3\"><title>\u012evair\u016bs</title><remarkFreeText><translation>40 ir 99\u00a0pakeitimai buvo at\u0161aukti.</translation></remarkFreeText></remarkFreeTexts>",
                "sk": "<remarkFreeTexts order=\"3\"><title>In\u00e9</title><remarkFreeText><translation>PN 40 a 99 boli zru\u0161en\u00e9.</translation></remarkFreeText></remarkFreeTexts>",
                "fi": "<remarkFreeTexts order=\"3\"><title>Muuta</title><remarkFreeText><translation>Tarkistukset 40 ja 99 mit\u00e4t\u00f6itiin.</translation></remarkFreeText></remarkFreeTexts>",
                "it": "<remarkFreeTexts order=\"3\"><title>Varie</title><remarkFreeText><translation>Gli emendamenti 40 e 99 sono stati annullati.</translation></remarkFreeText></remarkFreeTexts>",
                "fr": "<remarkFreeTexts order=\"3\"><title>Divers</title><remarkFreeText><translation>Les amendements 40 et 99 ont \u00e9t\u00e9 annul\u00e9s.</translation></remarkFreeText></remarkFreeTexts>",
                "hr": "<remarkFreeTexts order=\"3\"><title>Razno</title><remarkFreeText><translation>Amandmani 40 i 99 povu\u010deni su.</translation></remarkFreeText></remarkFreeTexts>",
                "cs": "<remarkFreeTexts order=\"3\"><title>R\u016fzn\u00e9</title><remarkFreeText><translation>Pn. 40 a 99 byly zru\u0161eny.</translation></remarkFreeText></remarkFreeTexts>",
                "ro": "<remarkFreeTexts order=\"3\"><title>Diverse</title><remarkFreeText><translation>Amendamentele 40 \u0219i 99 au fost anulate.</translation></remarkFreeText></remarkFreeTexts>",
                "el": "<remarkFreeTexts order=\"3\"><title>\u0394\u03b9\u03ac\u03c6\u03bf\u03c1\u03b1</title><remarkFreeText><translation>\u039f\u03b9 \u03c4\u03c1\u03bf\u03c0\u03bf\u03bb\u03bf\u03b3\u03af\u03b5\u03c2 40 \u03ba\u03b1\u03b9 99 \u03b1\u03ba\u03c5\u03c1\u03ce\u03bd\u03bf\u03bd\u03c4\u03b1\u03b9.</translation></remarkFreeText></remarkFreeTexts>"
