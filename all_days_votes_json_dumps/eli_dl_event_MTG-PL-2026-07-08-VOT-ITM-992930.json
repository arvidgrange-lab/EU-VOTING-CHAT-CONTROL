            "comment": {
                "el": "<remarkFreeTexts order=\"3\"><title>\u0394\u03b9\u03ac\u03c6\u03bf\u03c1\u03b1</title><remarkFreeText><translation>\u0397 \u03c4\u03c1\u03bf\u03c0\u03bf\u03bb\u03bf\u03b3\u03af\u03b1 46 \u03b1\u03c0\u03bf\u03c3\u03cd\u03c1\u03b5\u03c4\u03b1\u03b9.</translation></remarkFreeText></remarkFreeTexts>",
                "et": "<remarkFreeTexts order=\"3\"><title>Muud k\u00fcsimused</title><remarkFreeText><translation>Muudatusettepanek 46 v\u00f5eti tagasi.</translation></remarkFreeText></remarkFreeTexts>",
                "nl": "<remarkFreeTexts order=\"3\"><title>Diversen</title><remarkFreeText><translation>Amendement\u00a046\u00a0is ingetrokken.</translation></remarkFreeText></remarkFreeTexts>",
                "es": "<remarkFreeTexts order=\"3\"><title>Varios</title><remarkFreeText><translation>La enmienda 46 ha sido retirada.</translation></remarkFreeText></remarkFreeTexts>",
                "da": "<remarkFreeTexts order=\"3\"><title>Diverse</title><remarkFreeText><translation>\u00c6ndringsforslag 46a var taget tilbage.</translation></remarkFreeText></remarkFreeTexts>",
                "lv": "<remarkFreeTexts order=\"3\"><title>Da\u017e\u0101di</title><remarkFreeText><translation>Groz\u012bjums Nr.\u00a046 bija atsaukts.</translation></remarkFreeText></remarkFreeTexts>",
                "sl": "<remarkFreeTexts order=\"3\"><title>Razno</title><remarkFreeText><translation>Predlog spremembe 46 je bil umaknjen.</translation></remarkFreeText></remarkFreeTexts>",
                "hr": "<remarkFreeTexts order=\"3\"><title>Razno</title><remarkFreeText><translation>Amandman 46 povu\u010den je.</translation></remarkFreeText></remarkFreeTexts>",
                "sv": "<remarkFreeTexts order=\"3\"><title>\u00d6vriga fr\u00e5gor</title><remarkFreeText><translation>\u00c4ndringsf\u00f6rslag 46a hade dragits tillbaka.</translation></remarkFreeText></remarkFreeTexts>",
                "en": "<remarkFreeTexts order=\"3\"><title>Miscellaneous</title><remarkFreeText><translation>Amendment 46 had been withdrawn.</translation></remarkFreeText></remarkFreeTexts>",
                "mt": "<remarkFreeTexts order=\"3\"><title>Varji</title><remarkFreeText><translation>L-emenda 46a \u0121iet irtirata.</translation></remarkFreeText></remarkFreeTexts>",
                "bg": "<remarkFreeTexts order=\"3\"><title>\u0420\u0430\u0437\u043d\u0438</title><remarkFreeText><translation>\u0418\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0435 46 \u0431\u0435\u0448\u0435 \u043e\u0442\u0442\u0435\u0433\u043b\u0435\u043d\u043e.</translation></remarkFreeText></remarkFreeTexts>",
                "ga": "<remarkFreeTexts order=\"3\"><title>Aon ghn\u00f3 eile</title><remarkFreeText><translation>Rinneadh Leas\u00fa 46 a tharraingt siar.</translation></remarkFreeText></remarkFreeTexts>",
                "fr": "<remarkFreeTexts order=\"3\"><title>Divers</title><remarkFreeText><translation>L'amendement 46 a \u00e9t\u00e9 retir\u00e9.\n</translation></remarkFreeText></remarkFreeTexts>",
                "hu": "<remarkFreeTexts order=\"3\"><title>Egy\u00e9b</title><remarkFreeText><translation>A 46a. m\u00f3dos\u00edt\u00e1st visszavont\u00e1k.</translation></remarkFreeText></remarkFreeTexts>",
                "cs": "<remarkFreeTexts order=\"3\"><title>R\u016fzn\u00e9</title><remarkFreeText><translation>Pozm\u011b\u0148ovac\u00ed n\u00e1vrh 46 byl vzat zp\u011bt.\n</translation></remarkFreeText></remarkFreeTexts>",
                "de": "<remarkFreeTexts order=\"3\"><title>Verschiedenes</title><remarkFreeText><translation>\u00c4nderungsantrag\u00a046 wurde zur\u00fcckgezogen.</translation></remarkFreeText></remarkFreeTexts>",
                "ro": "<remarkFreeTexts order=\"3\"><title>Diverse</title><remarkFreeText><translation>Amendamentul 46 a fost retras.</translation></remarkFreeText></remarkFreeTexts>",
                "pt": "<remarkFreeTexts order=\"3\"><title>Diversos</title><remarkFreeText><translation>A altera\u00e7\u00e3o 46 foi retirada.</translation></remarkFreeText></remarkFreeTexts>",
                "lt": "<remarkFreeTexts order=\"3\"><title>\u012evair\u016bs</title><remarkFreeText><translation>46a\u00a0pakeitimas buvo at\u0161auktas.</translation></remarkFreeText></remarkFreeTexts>",
                "pl": "<remarkFreeTexts order=\"3\"><title>R\u00f3\u017cne</title><remarkFreeText><translation>Poprawk\u0119 46 wycofano.</translation></remarkFreeText></remarkFreeTexts>",
                "sk": "<remarkFreeTexts order=\"3\"><title>In\u00e9</title><remarkFreeText><translation>PN 46 bol stiahnut\u00fd.</translation></remarkFreeText></remarkFreeTexts>",
                "fi": "<remarkFreeTexts order=\"3\"><title>Muuta</title><remarkFreeText><translation>Tarkistus 46 peruutettiin.\n</translation></remarkFreeText></remarkFreeTexts>",
                "it": "<remarkFreeTexts order=\"3\"><title>Varie</title><remarkFreeText><translation>L'emendamento 46 \u00e8 stato ritirato.</translation></remarkFreeText></remarkFreeTexts>"
            },
