            "comment": {
                "lv": "<remarkFreeTexts order=\"2\"><title>Da\u017e\u0101di</title><remarkFreeText><translation>Groz\u012bjumi Nr.\u00a0286, 287, 291 bija atsaukti.</translation></remarkFreeText></remarkFreeTexts>",
                "da": "<remarkFreeTexts order=\"2\"><title>Diverse</title><remarkFreeText><translation>\u00c6ndringsforslag 286, 287, 291 blev trukket tilbage.</translation></remarkFreeText></remarkFreeTexts>",
                "cs": "<remarkFreeTexts order=\"2\"><title>R\u016fzn\u00e9</title><remarkFreeText><translation>Pn. 286, 287, 291 byly sta\u017eeny.</translation></remarkFreeText></remarkFreeTexts>",
                "pl": "<remarkFreeTexts order=\"2\"><title>Sprawy r\u00f3\u017cne</title><remarkFreeText><translation>Poprawki 286, 287, 291 zosta\u0142y wycofane.</translation></remarkFreeText></remarkFreeTexts>",
                "el": "<remarkFreeTexts order=\"2\"><title>\u0394\u03b9\u03ac\u03c6\u03bf\u03c1\u03b1</title><remarkFreeText><translation>\u039f\u03b9 \u03c4\u03c1\u03bf\u03c0\u03bf\u03bb\u03bf\u03b3\u03af\u03b5\u03c2 286, 287, 291 \u03b1\u03c0\u03bf\u03c3\u03cd\u03c1\u03bf\u03bd\u03c4\u03b1\u03b9.</translation></remarkFreeText></remarkFreeTexts>",
                "de": "<remarkFreeTexts order=\"2\"><title>Verschiedenes</title><remarkFreeText><translation>Die \u00c4nderungsantr\u00e4ge\u00a0286, 287 und 291 wurden zur\u00fcckgezogen.</translation></remarkFreeText></remarkFreeTexts>",
                "et": "<remarkFreeTexts order=\"2\"><title>Muud k\u00fcsimused</title><remarkFreeText><translation>Muudatusettepanekud 286, 287, 291 v\u00f5eti tagasi.</translation></remarkFreeText></remarkFreeTexts>",
                "pt": "<remarkFreeTexts order=\"2\"><title>Diversos</title><remarkFreeText><translation>As altera\u00e7\u00f5es 286, 287, 291 foram retiradas.</translation></remarkFreeText></remarkFreeTexts>",
                "es": "<remarkFreeTexts order=\"2\"><title>Varios</title><remarkFreeText><translation>Las enmiendas 286, 287, 291 han sido retiradas.</translation></remarkFreeText></remarkFreeTexts>",
                "bg": "<remarkFreeTexts order=\"2\"><title>\u0420\u0430\u0437\u043d\u0438</title><remarkFreeText><translation>\u0418\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f 286, 287, 291 \u0431\u044f\u0445\u0430 \u043e\u0442\u0442\u0435\u0433\u043b\u0435\u043d\u0438.</translation></remarkFreeText></remarkFreeTexts>",
                "sv": "<remarkFreeTexts order=\"2\"><title>\u00d6vriga fr\u00e5gor</title><remarkFreeText><translation>\u00c4ndringsf\u00f6rslagen 286, 287, 291 hade dragits tillbaka.</translation></remarkFreeText></remarkFreeTexts>",
                "lt": "<remarkFreeTexts order=\"2\"><title>\u012evair\u016bs</title><remarkFreeText><translation>286, 287 ir 291 pakeitimai buvo at\u0161aukti.</translation></remarkFreeText></remarkFreeTexts>",
                "mt": "<remarkFreeTexts order=\"2\"><title>Varji</title><remarkFreeText><translation>L-emendi \u00a0286, 287, 291 \u0121ew irtirati.</translation></remarkFreeText></remarkFreeTexts>",
                "sl": "<remarkFreeTexts order=\"2\"><title>Razno</title><remarkFreeText><translation>Predlogi sprememb 286, 287, 291 so bili umaknjeni.</translation></remarkFreeText></remarkFreeTexts>",
                "it": "<remarkFreeTexts order=\"2\"><title>Varie</title><remarkFreeText><translation>Gli emendamenti 286, 287 e 291 sono stati ritirati.</translation></remarkFreeText></remarkFreeTexts>",
                "en": "<remarkFreeTexts order=\"2\"><title>Miscellaneous</title><remarkFreeText><translation>Amendments 286, 287 and 291 had been withdrawn.</translation></remarkFreeText></remarkFreeTexts>",
                "fr": "<remarkFreeTexts order=\"2\"><title>Divers</title><remarkFreeText><translation>Les amendements 286, 287, 291 ont \u00e9t\u00e9 retir\u00e9s.</translation></remarkFreeText></remarkFreeTexts>",
                "ga": "<remarkFreeTexts order=\"2\"><title>Aon ghn\u00f3 eile</title><remarkFreeText><translation>Rinneadh leasuithe 286, 287, 291 a tharraingt siar.</translation></remarkFreeText></remarkFreeTexts>",
                "sk": "<remarkFreeTexts order=\"2\"><title>In\u00e9</title><remarkFreeText><translation>PN 286, 37 a 291 boli stiahnut\u00e9.</translation></remarkFreeText></remarkFreeTexts>",
                "hr": "<remarkFreeTexts order=\"2\"><title>Razno</title><remarkFreeText><translation>Amandmani 286, 287 i 291 povu\u010deni su.</translation></remarkFreeText></remarkFreeTexts>",
                "ro": "<remarkFreeTexts order=\"2\"><title>Diverse</title><remarkFreeText><translation>Amendamentele 286, 287, 291 au fost retrase.</translation></remarkFreeText></remarkFreeTexts>",
                "nl": "<remarkFreeTexts order=\"2\"><title>Diversen</title><remarkFreeText><translation>De amendementen\u00a0286, 287 en 291 zijn ingetrokken.</translation></remarkFreeText></remarkFreeTexts>",
                "fi": "<remarkFreeTexts order=\"2\"><title>Muuta</title><remarkFreeText><translation>Tarkistukset 286, 287 ja 291 peruutettiin.</translation></remarkFreeText></remarkFreeTexts>",
                "hu": "<remarkFreeTexts order=\"2\"><title>Egy\u00e9b</title><remarkFreeText><translation>A 286., 287. \u00e9s 291. m\u00f3dos\u00edt\u00e1st visszavont\u00e1k.</translation></remarkFreeText></remarkFreeTexts>"
            },
