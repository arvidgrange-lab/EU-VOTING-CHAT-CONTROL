            "comment": {
                "mt": "<remarkFreeTexts order=\"1\"><title>Varji</title><remarkFreeText><translation>L-emendi 121, 122 u 123 \u0121ew irtirati.</translation></remarkFreeText></remarkFreeTexts>",
                "lv": "<remarkFreeTexts order=\"1\"><title>Da\u017e\u0101di</title><remarkFreeText><translation>Groz\u012bjumi Nr.\u00a0121, 122 un 123 bija atsaukti.</translation></remarkFreeText></remarkFreeTexts>",
                "en": "<remarkFreeTexts order=\"1\"><title>Miscellaneous</title><remarkFreeText><translation>Amendments 121, 122 and 123 had been withdrawn.</translation></remarkFreeText></remarkFreeTexts>",
                "sk": "<remarkFreeTexts order=\"1\"><title>R\u00f4zne ot\u00e1zky</title><remarkFreeText><translation>PN 121, 122 a 123 boli stiahnut\u00e9.</translation></remarkFreeText></remarkFreeTexts>",
                "ro": "<remarkFreeTexts order=\"1\"><title>Diverse</title><remarkFreeText><translation>Amendamentele 121, 122 \u0219i 123 au fost retrase.</translation></remarkFreeText></remarkFreeTexts>",
                "fr": "<remarkFreeTexts order=\"1\"><title>Divers</title><remarkFreeText><translation>Les amendements 121, 122 et 123 ont \u00e9t\u00e9 retir\u00e9s.</translation></remarkFreeText></remarkFreeTexts>",
                "fi": "<remarkFreeTexts order=\"1\"><title>Muuta</title><remarkFreeText><translation>Tarkistukset 121, 122 ja 123 peruutettiin.</translation></remarkFreeText></remarkFreeTexts>",
                "et": "<remarkFreeTexts order=\"1\"><title>Muud k\u00fcsimused</title><remarkFreeText><translation>Muudatusettepanekud 121, 122 ja 123 v\u00f5eti tagasi.</translation></remarkFreeText></remarkFreeTexts>",
                "de": "<remarkFreeTexts order=\"1\"><title>Verschiedenes</title><remarkFreeText><translation>Die \u00c4nderungsantr\u00e4ge\u00a0121, 122 und 123 wurden zur\u00fcckgezogen.</translation></remarkFreeText></remarkFreeTexts>",
                "sl": "<remarkFreeTexts order=\"1\"><title>Razno</title><remarkFreeText><translation>Predlogi sprememb 121, 122 in 123 so bili umaknjeni.</translation></remarkFreeText></remarkFreeTexts>",
                "pl": "<remarkFreeTexts order=\"1\"><title>R\u00f3\u017cne</title><remarkFreeText><translation>Poprawki nr 121, 122 i 123 zosta\u0142y wycofane.</translation></remarkFreeText></remarkFreeTexts>",
                "da": "<remarkFreeTexts order=\"1\"><title>Diverse</title><remarkFreeText><translation>\u00c6ndringsforslag 121, 122 og 123 blev trukket tilbage.</translation></remarkFreeText></remarkFreeTexts>",
                "it": "<remarkFreeTexts order=\"1\"><title>Varie</title><remarkFreeText><translation>Gli emendamenti 121, 122 e 123 sono stati ritirati.</translation></remarkFreeText></remarkFreeTexts>",
                "hr": "<remarkFreeTexts order=\"1\"><title>Razno</title><remarkFreeText><translation>Stavci 121., 122. i 123. povu\u010deni su.</translation></remarkFreeText></remarkFreeTexts>",
                "cs": "<remarkFreeTexts order=\"1\"><title>R\u016fzn\u00e9</title><remarkFreeText><translation>Pn. 121, 122 a 123 byly sta\u017eeny.</translation></remarkFreeText></remarkFreeTexts>",
                "es": "<remarkFreeTexts order=\"1\"><title>Varios</title><remarkFreeText><translation>Las enmiendas 121, 122 y 123 han sido retiradas.</translation></remarkFreeText></remarkFreeTexts>",
                "hu": "<remarkFreeTexts order=\"1\"><title>Egy\u00e9b</title><remarkFreeText><translation>A 121., 122. \u00e9s 123. m\u00f3dos\u00edt\u00e1st visszavont\u00e1k.</translation></remarkFreeText></remarkFreeTexts>",
                "lt": "<remarkFreeTexts order=\"1\"><title>\u012evair\u016bs</title><remarkFreeText><translation>121, 122 ir 123\u00a0pakeitimai buvo at\u0161aukti.</translation></remarkFreeText></remarkFreeTexts>",
                "bg": "<remarkFreeTexts order=\"1\"><title>\u0420\u0430\u0437\u043d\u0438</title><remarkFreeText><translation>\u0418\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f 121, 122 \u0438 123 \u0431\u044f\u0445\u0430 \u043e\u0442\u0442\u0435\u0433\u043b\u0435\u043d\u0438.</translation></remarkFreeText></remarkFreeTexts>",
                "el": "<remarkFreeTexts order=\"1\"><title>\u0394\u03b9\u03ac\u03c6\u03bf\u03c1\u03b1</title><remarkFreeText><translation>\u039f\u03b9 \u03c4\u03c1\u03bf\u03c0\u03bf\u03bb\u03bf\u03b3\u03af\u03b5\u03c2 121, 122 \u03ba\u03b1\u03b9 123 \u03b1\u03c0\u03bf\u03c3\u03cd\u03c1\u03b8\u03b7\u03ba\u03b1\u03bd.</translation></remarkFreeText></remarkFreeTexts>",
                "pt": "<remarkFreeTexts order=\"1\"><title>Diversos</title><remarkFreeText><translation>As altera\u00e7\u00f5es 121, 122 e 123 foram retiradas.</translation></remarkFreeText></remarkFreeTexts>",
                "sv": "<remarkFreeTexts order=\"1\"><title>\u00d6vrigt</title><remarkFreeText><translation>\u00c4ndringsf\u00f6rslagen 121, 122 och 123 drogs tillbaka.</translation></remarkFreeText></remarkFreeTexts>",
