            "comment": {
                "ro": "<remarkFreeTexts order=\"1\"><title>Diverse</title><remarkFreeText><translation>Amendamentele 533 \u0219i 534 au fost anulate.</translation></remarkFreeText></remarkFreeTexts>",
                "lv": "<remarkFreeTexts order=\"1\"><title>Da\u017e\u0101di</title><remarkFreeText><translation>Groz\u012bjumi Nr.\u00a0533 un 534 bija atcelti.</translation></remarkFreeText></remarkFreeTexts>",
                "da": "<remarkFreeTexts order=\"1\"><title>Diverse</title><remarkFreeText><translation>\u00c6ndringsforslag 533 og 534 blev trukket tilbage.</translation></remarkFreeText></remarkFreeTexts>",
                "sv": "<remarkFreeTexts order=\"1\">\n                            <title>\u00d6vriga fr\u00e5gor</title>\n                            <remarkFreeText>\n                                <translation>\u00c4ndringsf\u00f6rslagen 533 och 534 hade strukits.</translation>\n                            </remarkFreeText>\n                        </remarkFreeTexts>",
                "nl": "<remarkFreeTexts order=\"1\"><title>Diversen</title><remarkFreeText><translation>De amendementen\u00a0533 en\u00a0534 zijn geannuleerd.</translation></remarkFreeText></remarkFreeTexts>",
                "fr": "<remarkFreeTexts order=\"1\"><title>Divers</title><remarkFreeText><translation>Les amendements 533 et 534 ont \u00e9t\u00e9 annul\u00e9s.</translation></remarkFreeText></remarkFreeTexts>",
                "sl": "<remarkFreeTexts order=\"1\"><title>Razno</title><remarkFreeText><translation>Predloga sprememb 533 in 534 sta bila razveljavljena.</translation></remarkFreeText></remarkFreeTexts>",
                "mt": "<remarkFreeTexts order=\"1\">\n                            <title>Varji</title>\n                            <remarkFreeText>\n                                <translation>L-emendi 533 u 534 t\u0127assru.</translation>\n                            </remarkFreeText>\n                        </remarkFreeTexts>",
                "lt": "<remarkFreeTexts order=\"1\">\n                            <title>\u012evair\u016bs</title>\n                            <remarkFreeText>\n                                <translation>533 ir 534\u00a0pakeitimai buvo at\u0161aukti.</translation>\n                            </remarkFreeText>\n                        </remarkFreeTexts>",
                "de": "<remarkFreeTexts order=\"1\">\n                            <title>Verschiedenes</title>\n                            <remarkFreeText>\n                                <translation>Die \u00c4nderungsantr\u00e4ge 533 und 534 wurden annulliert.</translation>\n                            </remarkFreeText>\n                        </remarkFreeTexts>",
                "bg": "<remarkFreeTexts order=\"1\"><title>\u0420\u0430\u0437\u043d\u0438</title><remarkFreeText><translation>\u0418\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f 533 \u0438 534 \u0431\u044f\u0445\u0430 \u0430\u043d\u0443\u043b\u0438\u0440\u0430\u043d\u0438.</translation></remarkFreeText></remarkFreeTexts>",
                "es": "<remarkFreeTexts order=\"1\"><title>Varios</title><remarkFreeText><translation>Las enmiendas 533 y 534 han sido anuladas.</translation></remarkFreeText></remarkFreeTexts>",
                "el": "<remarkFreeTexts order=\"1\"><title>\u0394\u03b9\u03ac\u03c6\u03bf\u03c1\u03b1</title><remarkFreeText><translation>\u039f\u03b9 \u03c4\u03c1\u03bf\u03c0\u03bf\u03bb\u03bf\u03b3\u03af\u03b5\u03c2 533 \u03ba\u03b1\u03b9 534 \u03b1\u03ba\u03c5\u03c1\u03ce\u03b8\u03b7\u03ba\u03b1\u03bd.</translation></remarkFreeText></remarkFreeTexts>",
                "ga": "<remarkFreeTexts order=\"1\">\n                            <title>Aon ghn\u00f3 eile</title>\n                            <remarkFreeText>\n                                <translation>Cuireadh leasuithe 533 agus 534 ar ceal.</translation>\n                            </remarkFreeText>\n                        </remarkFreeTexts>",
                "hu": "<remarkFreeTexts order=\"1\">\n                            <title>Egy\u00e9b</title>\n                            <remarkFreeText>\n                                <translation>Az 533. \u00e9s 534. m\u00f3dos\u00edt\u00e1st visszavont\u00e1k.</translation>\n                            </remarkFreeText>\n                        </remarkFreeTexts>",
                "it": "<remarkFreeTexts order=\"1\"><title>Varie</title><remarkFreeText><translation>Gli emendamenti 533 e 534 sono stati annullati.</translation></remarkFreeText></remarkFreeTexts>",
                "en": "<remarkFreeTexts order=\"1\"><title>Miscellaneous</title><remarkFreeText><translation>Amendments 533 and 534 had been cancelled.</translation></remarkFreeText></remarkFreeTexts>",
                "sk": "<remarkFreeTexts order=\"1\"><title>In\u00e9</title><remarkFreeText><translation>PN 533 a 534 boli zru\u0161en\u00e9.</translation></remarkFreeText></remarkFreeTexts>",
                "et": "<remarkFreeTexts order=\"1\">\n       <title>Mitmesugust</title>\n       <remarkFreeText>\n        <translation>Muudatusettepanekud 533 ja 534 t\u00fchistati.</translation>\n       </remarkFreeText>\n      </remarkFreeTexts>",
                "hr": "<remarkFreeTexts order=\"1\"><title>Razno</title><remarkFreeText><translation>Amandmani 533 i 534 povu\u010deni su.</translation></remarkFreeText></remarkFreeTexts>",
                "pl": "<remarkFreeTexts order=\"1\"><title>R\u00f3\u017cne</title><remarkFreeText><translation>Poprawki 533 i 534 zosta\u0142y anulowane.</translation></remarkFreeText></remarkFreeTexts>",
                "cs": "<remarkFreeTexts order=\"1\"><title>R\u016fzn\u00e9</title><remarkFreeText><translation>Pn. 533 a 534 byly zru\u0161eny.</translation></remarkFreeText></remarkFreeTexts>",
                "pt": "<remarkFreeTexts order=\"1\"><title>Diversos</title><remarkFreeText><translation>As altera\u00e7\u00f5es 533 e 534 foram anuladas.</translation></remarkFreeText></remarkFreeTexts>",
                "fi": "<remarkFreeTexts order=\"1\"><title>Muuta</title><remarkFreeText><translation>Tarkistukset 533 ja 534 mit\u00e4t\u00f6itiin.</translation></remarkFreeText></remarkFreeTexts>"
