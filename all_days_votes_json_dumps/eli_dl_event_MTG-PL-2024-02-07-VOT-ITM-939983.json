            "comment": {
                "sv": "<remarkFreeTexts order=\"3\"><title>\u00d6vriga fr\u00e5gor</title><remarkFreeText><translation>\u00c4ndringsf\u00f6rslag 130 hade strukits.</translation></remarkFreeText><remarkFreeText><translation>\u00c4ndringsf\u00f6rslag 280\u2013283 hade dragits tillbaka.</translation></remarkFreeText></remarkFreeTexts>",
                "it": "<remarkFreeTexts order=\"3\"><title>Varie</title><remarkFreeText><translation>L'emendamento 130 \u00e8 stato annullato.</translation></remarkFreeText><remarkFreeText><translation>Gli emendamenti 280-283 sono stati ritirati.</translation></remarkFreeText></remarkFreeTexts>",
                "de": "<remarkFreeTexts order=\"3\"><title>Verschiedenes</title><remarkFreeText><translation>\u00c4nderungsantrag\u00a0130 wurde annulliert.</translation></remarkFreeText><remarkFreeText><translation>Die \u00c4nderungsantr\u00e4ge\u00a0280 bis 283 wurden zur\u00fcckgezogen.</translation></remarkFreeText></remarkFreeTexts>",
                "mt": "<remarkFreeTexts order=\"3\"><title>Varji</title><remarkFreeText><translation>L-emenda 130 \u0121iet annullata.</translation></remarkFreeText><remarkFreeText><translation>L-emendi 280-283 \u0121ew irtirati.</translation></remarkFreeText></remarkFreeTexts>",
                "fi": "<remarkFreeTexts order=\"3\"><title>Muuta</title><remarkFreeText><translation>Tarkistus 130 mit\u00e4t\u00f6itiin.</translation></remarkFreeText><remarkFreeText><translation>Tarkistukset 280\u2013283 peruutettiin.</translation></remarkFreeText></remarkFreeTexts>",
                "et": "<remarkFreeTexts order=\"3\"><title>Muud k\u00fcsimused</title><remarkFreeText><translation>Muudatusettepanek 130 t\u00fchistati.</translation></remarkFreeText><remarkFreeText><translation>Muudatusettepanekud 280\u2013283 v\u00f5eti tagasi.</translation></remarkFreeText></remarkFreeTexts>",
                "en": "<remarkFreeTexts order=\"3\"><title>Miscellaneous</title><remarkFreeText><translation>Amendment 130 had been cancelled.</translation></remarkFreeText><remarkFreeText><translation>Amendments 280-283 had been withdrawn.</translation></remarkFreeText></remarkFreeTexts>",
                "pt": "<remarkFreeTexts order=\"3\"><title>Diversos</title><remarkFreeText><translation>A altera\u00e7\u00e3o 130 \u00e9 anulada.</translation></remarkFreeText><remarkFreeText><translation>As altera\u00e7\u00f5es 280-283 foram retiradas.</translation></remarkFreeText></remarkFreeTexts>",
                "sk": "<remarkFreeTexts order=\"3\">\n                            <title>In\u00e9</title>\n                            <remarkFreeText>\n                                <translation>PN 130 bol zru\u0161en\u00fd.</translation>\n                            </remarkFreeText>\n                            <remarkFreeText>\n                                <translation>Pozme\u0148uj\u00face n\u00e1vrhy 280 a\u017e 283 boli stiahnut\u00e9.</translation>\n                            </remarkFreeText>\n                        </remarkFreeTexts>",
                "hu": "<remarkFreeTexts order=\"3\">\n                            <title>Egy\u00e9b</title>\n                            <remarkFreeText>\n                                <translation>A 130. m\u00f3dos\u00edt\u00e1st t\u00f6r\u00f6lt\u00e9k.</translation>\n                            </remarkFreeText>\n                            <remarkFreeText>\n                                <translation>A 280\u2013283. m\u00f3dos\u00edt\u00e1st visszavont\u00e1k.</translation>\n                            </remarkFreeText>\n                        </remarkFreeTexts>",
                "lv": "<remarkFreeTexts order=\"3\"><title>Da\u017e\u0101di</title><remarkFreeText><translation>Groz\u012bjums Nr.\u00a0250 bija atcelts.</translation></remarkFreeText><remarkFreeText><translation>Groz\u012bjumi Nr.\u00a0280\u2013283 bija atsaukti.</translation></remarkFreeText></remarkFreeTexts>",
                "bg": "<remarkFreeTexts order=\"3\"><title>\u0420\u0430\u0437\u043d\u0438</title><remarkFreeText><translation>\u0418\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0435 130 \u0431\u0435\u0448\u0435 \u0430\u043d\u0443\u043b\u0438\u0440\u0430\u043d\u043e.</translation></remarkFreeText><remarkFreeText><translation>\u0418\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f 280\u2014283 \u0431\u044f\u0445\u0430 \u043e\u0442\u0442\u0435\u0433\u043b\u0435\u043d\u0438.</translation></remarkFreeText></remarkFreeTexts>",
                "ro": "<remarkFreeTexts order=\"3\"><title>Diverse</title><remarkFreeText><translation>Amendamentul 130 a fost anulat.</translation></remarkFreeText><remarkFreeText><translation>Amendamentele 280-283 au fost retrase.</translation></remarkFreeText></remarkFreeTexts>",
                "cs": "<remarkFreeTexts order=\"3\">\n                            <title>R\u016fzn\u00e9</title>\n                            <remarkFreeText>\n                                <translation>Pn. 130 byl zru\u0161en.</translation>\n                            </remarkFreeText>\n                            <remarkFreeText>\n                                <translation>Pn. 280\u2013283 byly vzaty zp\u011bt.</translation>\n                            </remarkFreeText>\n                        </remarkFreeTexts>",
                "pl": "<remarkFreeTexts order=\"3\"><title>R\u00f3\u017cne</title><remarkFreeText><translation>Poprawk\u0119 130 anulowano.</translation></remarkFreeText><remarkFreeText><translation>Poprawki 280\u2013283 zosta\u0142y anulowane.</translation></remarkFreeText></remarkFreeTexts>",
                "es": "<remarkFreeTexts order=\"3\"><title>Varios</title><remarkFreeText><translation>La enmienda 130 ha sido anulada.</translation></remarkFreeText><remarkFreeText><translation>Las enmiendas 280-283 han sido retiradas.</translation></remarkFreeText></remarkFreeTexts>",
                "da": "<remarkFreeTexts order=\"3\"><title>Diverse</title><remarkFreeText><translation>\u00c6ndringsforslag 130 var blevet annulleret.</translation></remarkFreeText><remarkFreeText><translation>\u00c6ndringsforslag 280-283 blev trukket tilbage</translation></remarkFreeText></remarkFreeTexts>",
                "ga": "<remarkFreeTexts order=\"3\"><title>Aon ghn\u00f3 eile</title><remarkFreeText><translation>Rinneadh Leas\u00fa\u00a0130 a cheal\u00fa.</translation></remarkFreeText><remarkFreeText><translation>Rinneadh leasuithe 280-283 a tharraingt siar.</translation></remarkFreeText></remarkFreeTexts>",
                "hr": "<remarkFreeTexts order=\"3\"><title>Razno</title><remarkFreeText><translation>Amandman 130 je poni\u0161ten.</translation></remarkFreeText><remarkFreeText><translation>Amandmani 280-283 povu\u010deni su.</translation></remarkFreeText></remarkFreeTexts>",
                "sl": "<remarkFreeTexts order=\"3\"><title>Razno</title><remarkFreeText><translation>Predlog spremembe 130 je bil razveljavljen.</translation></remarkFreeText><remarkFreeText><translation>Predlogi sprememb 280\u2013283 so bili umaknjeni.</translation></remarkFreeText></remarkFreeTexts>",
                "el": "<remarkFreeTexts order=\"3\">\n                            <title>\u0394\u03b9\u03ac\u03c6\u03bf\u03c1\u03b1</title>\n                            <remarkFreeText>\n                                <translation>\u0397 \u03c4\u03c1\u03bf\u03c0\u03bf\u03bb\u03bf\u03b3\u03af\u03b1 130 \u03b1 \u03b1\u03ba\u03c5\u03c1\u03ce\u03bd\u03b5\u03c4\u03b1\u03b9.</translation>\n                            </remarkFreeText>\n                            <remarkFreeText>\n                                <translation>\u039f\u03b9 \u03c4\u03c1\u03bf\u03c0\u03bf\u03bb\u03bf\u03b3\u03af\u03b5\u03c2 280-283 \u03b1\u03c0\u03bf\u03c3\u03cd\u03c1\u03bf\u03bd\u03c4\u03b1\u03b9.</translation>\n                            </remarkFreeText>\n                        </remarkFreeTexts>",
                "nl": "<remarkFreeTexts order=\"3\"><title>Diversen</title><remarkFreeText><translation>Amendement\u00a0130\u00a0bis is geannuleerd.</translation></remarkFreeText><remarkFreeText><translation>De amendementen\u00a0280 t/m\u00a0283 zijn ingetrokken.</translation></remarkFreeText></remarkFreeTexts>",
                "fr": "<remarkFreeTexts order=\"3\"><title>Divers</title><remarkFreeText><translation>L'amendement 130 a \u00e9t\u00e9 annul\u00e9.</translation></remarkFreeText><remarkFreeText><translation>Les amendements 280-283 ont \u00e9t\u00e9 retir\u00e9s.</translation></remarkFreeText></remarkFreeTexts>",
